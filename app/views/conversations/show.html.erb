<div class="post_page">
  <%= link_to conversations_path, class: "back_link" do %>
    <span aria-hidden="true">←</span> Messages
  <% end %>

  <section class="chat_card" aria-labelledby="chat_title">
    <header class="chat_header">
      <h1 id="chat_title" class="chat_title"><%= @conversation.title_for(current_user) %></h1>
      <% if @conversation.post %>
        <%= link_to "View post", post_path(@conversation.post), class: "text_action" %>
      <% end %>
    </header>

    <div id="messages" class="message_list">
      <% if @messages.empty? %>
        <p class="messages_empty">Say hi to start the conversation.</p>
      <% end %>

      <% last_message = @messages.last %>

      <% @messages.each do |message| %>
        <% mine = message.user_id == current_user.id %>
        <% editing = mine && params[:editing].to_i == message.id && message.editable_by?(current_user) %>

        <div id="<%= dom_id(message) %>" class="message<%= ' is-mine' if mine %>">
          <% unless mine %>
            <span class="message_author"><%= message.display_author %></span>
          <% end %>

          <% if editing %>
            <%= form_with(model: [ @conversation, message ], class: "message_edit_form") do |form| %>
              <%= form.label :body, "Edit message", class: "visually_hidden", for: "edit_message_body" %>
              <%= form.text_area :body, rows: 2, maxlength: 2000, class: "form_input", id: "edit_message_body" %>
              <div class="message_edit_buttons">
                <%= link_to "Cancel", conversation_path(@conversation, anchor: dom_id(message)), class: "text_action" %>
                <%= form.submit "Save", class: "primary_button" %>
              </div>
            <% end %>
          <% else %>
            <div class="message_bubble"><%= simple_format(message.body) %></div>
          <% end %>

          <div class="message_footer">
            <% if mine && message == last_message %>
              <% seen = @conversation.seen_by(message) %>
              <span class="message_receipt">
                <% if seen.empty? %>
                  Sent
                <% elsif @conversation.group? %>
                  Seen by <%= seen.map { |person| @conversation.name_for(person) }.to_sentence %>
                <% else %>
                  Seen
                <% end %>
              </span>
              <span class="message_separator" aria-hidden="true">●</span>
            <% end %>
            <time class="message_time" datetime="<%= message.created_at.iso8601 %>"
                  title="<%= message.created_at.strftime("%B %-d, %Y at %-l:%M %p") %>">
              <%= short_time_ago(message.created_at) %>
            </time>
            <% if message.edited? %>
              <span class="message_edited">· Edited</span>
            <% end %>
          </div>

          <% if mine && !editing %>
            <div class="message_actions">
              <% if message.editable_by?(current_user) %>
                <%= link_to "Edit", conversation_path(@conversation, editing: message.id, anchor: dom_id(message)),
                      class: "text_action message_action" %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <%= form_with(model: [ @conversation, @message ], id: "message_composer", class: "message_composer") do |form| %>
      <%= form.label :body, "Message", class: "visually_hidden" %>
      <%= form.text_area :body, rows: 2, maxlength: 2000, class: "form_input",
            placeholder: "Write a message…" %>
      <%= form.submit "Send", class: "primary_button" %>
    <% end %>
  </section>
</div>