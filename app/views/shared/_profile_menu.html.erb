<details class="profile_menu">
  <summary class="avatar">
    <%= current_user.name.to_s.first.upcase %>
  </summary>

  <div class="profile_dropdown">
    <div class="profile_header">
      <span class="avatar"><%= current_user.name.to_s.first.upcase %></span>
      <div>
        <div class="profile_name"><%= current_user.name %></div>
        <div class="profile_email"><%= current_user.email %></div>
      </div>
    </div>

    <hr>

    <%= button_to "Log out", destroy_user_session_path, method: :delete %>
  </div>
</details>