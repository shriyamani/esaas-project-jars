<%= form_with model: [post, local_assigns.fetch(:reply) { Reply.new }] do |f| %>
  <% if f.object.errors.any? %>
    <div role="alert"><%= f.object.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="mb-3">
    <%= f.label :body, "Write a reply" %>

    <%= f.text_area :body,
          class: "form-control",
          rows: 3,
          maxlength: 2000,
          required: true %>
  </div>

  <div class="form-check mb-3">
    <%= f.check_box :anonymous,
          class: "form-check-input" %>

    <%= f.label :anonymous,
          "Reply anonymously",
          class: "form-check-label" %>
  </div>

  <%= f.submit(f.object.persisted? ? "Save Reply" : "Post Reply",
        class: "btn btn-primary") %>
<% end %>