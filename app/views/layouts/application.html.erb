<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "LionDen" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="LionDen">
    <meta name="mobile-web-app-capable" content="yes">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if content_for?(:hide_chrome) %>
      <%# Public pages (sign-in, FAQ, About, Contact) render their own nav and flash %>
      <%= yield %>
    <% else %>
      <% if user_signed_in? %>
        <nav aria-label="Main navigation" class="main_nav">
          <%= link_to root_path, class: "brand", aria: { label: "LionDen home" } do %>
            <img src="/icon.png" alt="" class="brand_logo">
            <span class="brand_name">LionDen</span>
          <% end %>

          <div class="nav_actions">
            <% home_active = controller_name == "posts" && action_name == "index" &&
                            params[:category].blank? && params[:feed].blank? %>
            <%= link_to root_path, class: "nav_icon", title: "Home",
                  aria: { label: "Home", current: (home_active ? "page" : nil) } do %>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <path d="M3 11.5 12 4l9 7.5M5.5 9.5V20h5v-5.5h3V20h5V9.5"
                      fill="none" stroke="currentColor" stroke-width="2"
                      stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            <% end %>

            <% unread_count = current_user.unread_conversations_count %>
            <%= link_to conversations_path, class: "nav_icon", title: "Messages",
                  aria: { label: "Messages", current: (controller_name == "conversations" ? "page" : nil) } do %>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="2"/>
                <path d="M3.5 6.5 12 13l8.5-6.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              </svg>
              <% if unread_count.positive? %>
                <span class="nav_badge"><%= unread_count %><span class="visually_hidden"> unread</span></span>
              <% end %>
            <% end %>

            <%# Notification bell goes here %>

            <%= render "shared/profile_menu" %>
          </div>
        </nav>

        <%= render "shared/category_bar" %>
      <% end %>

      <%= render "shared/flash" %>

      <main><%= yield %></main>
    <% end %>
  </body>
</html>