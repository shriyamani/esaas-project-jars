<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "LionDen" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="LionDen">
    <meta name="mobile-web-app-capable" content="yes">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Bootstrap supplies the shared responsive baseline; app styles apply the LionDen theme. %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if content_for?(:hide_chrome) %>
      <%# Public pages (sign-in, FAQ, About, Contact) render their own nav and flash %>
      <%= yield %>
    <% else %>
      <% if user_signed_in? %>
        <nav aria-label="Main navigation" class="main_nav">
          <%= link_to root_path, class: "brand", aria: { label: "LionDen home" } do %>
            <img src="/icon.png" alt="" class="brand_logo">
            <span class="brand_name">LionDen</span>
          <% end %>

          <%= form_with url: posts_path, method: :get, class: "nav_search", data: { controller: "live-search" } do |form| %>
            <%= form.search_field :q, value: @search_query, placeholder: "Search posts", autocomplete: "off",
                  aria: { label: "Search posts" }, data: { action: "input->live-search#queue" } %>
            <%= form.button type: :submit, aria: { label: "Search" }, title: "Search" do %>
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/>
                <path d="m15.5 15.5 5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            <% end %>
          <% end %>

          <div class="nav_actions">
            <% home_active = controller_name == "posts" && action_name == "index" &&
                            params[:category].blank? && params[:feed].blank? && params[:q].blank? %>
            <%= link_to root_path, class: "nav_icon", title: "Home",
                  aria: { label: "Home", current: (home_active ? "page" : nil) } do %>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <path d="M2 11 12 2.5 22 11M4.5 9v12.5h6v-6h3v6h6V9"
                      fill="none" stroke="currentColor" stroke-width="2"
                      stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            <% end %>

            <% calendar_active = controller_name == "calendars" %>
            <%= link_to calendar_path, class: "nav_icon", title: "Calendar",
                  aria: { label: "Calendar", current: (calendar_active ? "page" : nil) } do %>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" fill="none" stroke="currentColor" stroke-width="2"/>
                <line x1="16" y1="2" x2="16" y2="6" stroke="currentColor" stroke-width="2"/>
                <line x1="8" y1="2" x2="8" y2="6" stroke="currentColor" stroke-width="2"/>
                <line x1="3" y1="10" x2="21" y2="10" stroke="currentColor" stroke-width="2"/>
              </svg>
            <% end %>

            <% unread_count = current_user.unread_conversations_count %>
            <%= link_to conversations_path, class: "nav_icon", title: "Messages",
                  aria: { label: "Messages", current: (controller_name == "conversations" ? "page" : nil) } do %>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="2"/>
                <path d="M2.5 5.5 12 13l9.5-7.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              </svg>
              <% if unread_count.positive? %>
                <span class="nav_badge"><%= unread_count %><span class="visually_hidden"> unread</span></span>
              <% end %>
            <% end %>

            <%= render "shared/notifications_menu" %>

            <%= render "shared/profile_menu" %>
          </div>
        </nav>

        <%= render "shared/category_bar" %>
      <% end %>

      <%= render "shared/flash" %>

      <main><%= yield %></main>
    <% end %>
  </body>
</html>
