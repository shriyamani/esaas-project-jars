<% liked = post.liked_by?(current_user) %>
<%= button_to post_like_path(post),
      method: (liked ? :delete : :post),
      class: "like_button#{' is-liked' if liked}",
      form: { class: "like_form" },
      aria: { label: "#{liked ? 'Unlike' : 'Like'} #{post.title}", pressed: liked } do %>
  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
    <path d="M12 21s-7.5-4.6-9.5-9.2C1.2 8.6 3.3 5 6.9 5c2 0 3.4 1 5.1 3 1.7-2 3.1-3 5.1-3 3.6 0 5.7 3.6 4.4 6.8C19.5 16.4 12 21 12 21z"
          fill="<%= liked ? 'currentColor' : 'none' %>"
          stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
  </svg>
  <span class="like_count"><%= post.likes.size %></span>
<% end %>