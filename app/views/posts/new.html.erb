<div class="post_page">
  <%= link_to my_activity_path, class: "back_link" do %>
    <span aria-hidden="true">←</span> Back to My Activity
  <% end %>

  <div class="post_form_card">
    <h1 class="post_form_title">New Post</h1>
    <%= render "form", post: @post, cancel_path: posts_path %>
  </div>
</div>
