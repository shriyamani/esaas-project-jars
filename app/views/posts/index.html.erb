<div class="feed_header">
  <h1><%= @view_title %></h1>
  <nav class="feed_sort" aria-label="Sort posts">
    <%= link_to "Newest", posts_path(@filter_params),
          class: "feed_sort_option",
          aria: { current: (@sort == "newest" ? "true" : nil) } %>
    <%= link_to "Trending", posts_path(@filter_params.merge(sort: "trending")),
          class: "feed_sort_option",
          aria: { current: (@sort == "trending" ? "true" : nil) } %>
  </nav>
</div>

<div id="posts">
  <% if @follows_nothing %>
    <div class="follow_prompt">
      <p>You're not following any categories yet. Follow one to see its posts here:</p>
      <div class="follow_prompt_buttons">
        <% Post::CATEGORIES.each do |category| %>
          <%= button_to "+ #{category}", category_follow_path,
                params: { category: category },
                class: "follow_prompt_button",
                form: { class: "follow_prompt_form" } %>
        <% end %>
      </div>
    </div>
  <% elsif @posts.empty? && params[:feed] == "mine" %>
    <p class="feed_empty">You don't have any active posts yet.</p>
  <% elsif @posts.empty? %>
    <p class="feed_empty"><%= params[:feed] == "following" ? "No active posts in the categories you follow." : "No active posts found." %></p>
  <% else %>
    <div class="post_grid">
      <%= render partial: "posts/post_card", collection: @posts, as: :post %>
    </div>
  <% end %>
</div>
