<%= form_with(model: post, class: "post_form", data: { controller: "post-form" }) do |form| %>
  <% if post.errors.any? %>
    <div id="error_explanation" class="form_errors">
      <h2><%= pluralize(post.errors.count, "error") %> prohibited this post from being saved:</h2>
      <ul>
        <% post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="post_type_selector" role="group" aria-label="Post type">
    <button type="button" class="post_type_button <%= 'is-active' unless post.event? %>" data-post-form-target="postBtn" data-action="click->post-form#userSelectPost">Regular Post</button>
    <button type="button" class="post_type_button <%= 'is-active' if post.event? %>" data-post-form-target="eventBtn" data-action="click->post-form#userSelectEvent">Event</button>
  </div>

  <div class="form_field">
    <%= form.label :title, class: "form_label" %>
    <%= form.text_field :title, class: "form_input form_input--title"%>
  </div>

  <div class="form_field">
    <%= form.label :body, class: "form_label" %>
    <%= form.text_area :body, rows: 6, class: "form_input"%>
  </div>

  <fieldset class="form_field">
    <legend class="form_label">Category</legend>
    <div class="chip_group">
      <% Post::CATEGORIES.each do |category| %>
        <label class="chip">
          <%= form.radio_button :category, category %>
          <span><%= category %></span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <fieldset class="form_field" data-post-form-target="expirationSection">
    <legend class="form_label">Expires</legend>

    <div class="chip_group">
      <% Post::EXPIRATION_PRESETS.each do |preset| %>
        <label class="chip">
          <%= form.radio_button :expiration_preset, preset %>
          <span><%= preset %></span>
        </label>
      <% end %>
    </div>

    <div class="expiration_custom">
      <%= form.label :custom_expires_at, "Custom expiration", class: "form_label form_label--small" %>
      <%= form.datetime_local_field :custom_expires_at, class: "form_input",
            min: Time.current.strftime("%Y-%m-%dT%H:%M") %>
    </div>
  </fieldset>

  <div class="event_fields_group" data-post-form-target="eventSection">
    <div class="form_field">
      <%= form.label :event_date, "Event Date", class: "form_label" %>
      <%= form.date_field :event_date, class: "form_input", data: { post_form_target: "eventDate" } %>
    </div>

    <div class="form_field">
      <%= form.label :event_time, "Event Time", class: "form_label" %>
      <%= form.text_field :event_time, class: "form_input", placeholder: "e.g. 5:00 PM or 9:00 PM - 10:00 PM", data: { post_form_target: "eventTime" } %>
    </div>

    <div class="form_field">
      <%= form.label :location, "Location", class: "form_label" %>
      <%= form.text_field :location, class: "form_input", placeholder: "e.g. Low Steps, Butler Library 209", data: { post_form_target: "location" } %>
    </div>
  </div>

  <div class="form_footer">
    <%= form.label :anonymous, class: "reply_form_checkbox" do %>
      <%= form.check_box :anonymous %>
      Post anonymously
    <% end %>

    <div class="reply_form_buttons">
      <%= link_to "Cancel", cancel_path, class: "secondary_button" %>
      <%= form.submit class: "primary_button" %>
    </div>
  </div>
<% end %>