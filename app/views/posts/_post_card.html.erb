<article id="<%= dom_id(post) %>" class="post_card">
  <header class="post_card_header">
  <%= render "users/avatar_menu",
      user: (post.anonymous? ? nil : post.user),
      initial: (post.anonymous? ? "?" : post.display_author.to_s.first.to_s.upcase),
      avatar_class: "post_card_avatar" %>
    <div class="post_card_meta">
      <span class="post_card_author"><%= post.display_author %></span>
      <span class="post_card_time"><%= time_ago_in_words(post.created_at) %> ago</span>
    </div>
    <span class="post_card_arrow" aria-hidden="true">↗</span>
  </header>

  <%# The title link stretches over the whole card, so clicking anywhere opens the post %>
  <h2 class="post_card_title"><%= link_to post.title, post_path(post), class: "post_card_link" %></h2>

  <% if post.body.present? %>
    <p class="post_card_body"><%= truncate(post.body, length: 140) %></p>
  <% end %>

  <% if local_assigns[:show_event_details] && post.event? %>
    <p class="activity_event_details">
      <strong><%= post.event_date.strftime("%B %-d, %Y") %><%= " · #{post.event_time}" if post.event_time.present? %></strong>
      <% if post.location.present? %><span><%= post.location %></span><% end %>
    </p>
  <% end %>

  <footer class="post_card_footer">
    <div class="post_card_stats">
      <span class="post_card_tag"><%= post.category %></span>
      <%= render "posts/like_button", post: post %>
      <span class="post_card_replies">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M4 4h16v12H8l-4 4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
        </svg>
        <%= pluralize(post.replies.size, "reply") %>
      </span>
    </div>
    <%= render "posts/expiration", expires_at: post.expires_at %>
  </footer>
</article>
